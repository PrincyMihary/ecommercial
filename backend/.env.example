# Configuration locale d'un développeur (voir migration_plan.md §17).
# Une instance PostgreSQL locale par développeur.

PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ecommercial
DATABASE_USER=postgres
DATABASE_PASSWORD=

JWT_SECRET=change-me-in-each-local-env
JWT_EXPIRES_IN=7d

# Taille max acceptée pour un upload d'image / modèle (voir §14).
UPLOAD_MAX_IMAGE_MB=8
UPLOAD_MAX_MODEL_MB=50

# NE PAS ajouter GOOGLE_PLACES_API_KEY ici : cette clé est un
# --dart-define Flutter, jamais une variable du backend (voir §15/§17).

# Copier ce fichier en .env et adapter les valeurs localement.
# Ne JAMAIS committer de secret réel.

# Port d'écoute du serveur HTTP (consommé par l'app Flutter en local)
PORT=3000

# Chaîne de connexion PostgreSQL
# Format : postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommercial

# Environnement d'exécution
NODE_ENV=development
